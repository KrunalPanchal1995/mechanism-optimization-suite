##############################################################################
# GUI stress-test dummy project config -- generated by
# make_gui_stress_fixtures.py. See GUI_STRESS_TEST_PLAN.md.
##############################################################################

project:
  name: GUI_Stress_Test
  fuel_name: H2
  fuel_formula: H2
  output_base_dir: outputs/gui_stress

Type:
  optimization_type: PRS
  Algorithm_type: gradient-based
  Algorithm: SLSQP

Counts:
  total_reactions: 3
  parallel_threads: 2
  targets_count: 2

SA:
  carbon_number: 0

Bin:
  bin: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress
  solver_bin: /home/krithika/FlameMaster/Bin/bin
  yaml_writer: /data/MECHANISM_OPTIMIZATION_SUITE/src/Sensitivity_Analysis/parallel_yaml_writer.so
  samap_executable: PLACEHOLDER_SAMAP
  jpdap_executable: PLACEHOLDER_JPDAP
  SA_tool: /data/MECHANISM_OPTIMIZATION_SUITE/src/Sensitivity_Analysis/sens.py
  SA_tool_3p: /data/MECHANISM_OPTIMIZATION_SUITE/src/Sensitivity_Analysis/sens_3_params.py

Inputs:
  fileType: cantera_yaml
  fuelClass: Mono
  fuel:
    a: H2
  global_reaction: 2H2+O2==2H2O
  AnalysisType: reaction

Locations:
  mechanism: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/mech_std.yaml
  Initial_pre_file: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/mech_std.pre
  uncertainty_data: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/h2_o2_crosscheck_unsrt.xml
  thermo_file: ''
  trans_file: ''
  targets: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/targets/gui_stress.target
  addendum: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/gui_stress.add

# Required by sens_3_params.py's module-level load even though no Fls/Flf
# targets are in this fixture's 2-target trio -- mirrors DATASET/H2_O2_TEST's
# placeholder shape.
StartProfilesData:
  Fls:
    Flame: UnstretchedPremixed
    StartProfilesFile: PLACEHOLDER_FLS_INIT
    CopyTo: PLACEHOLDER_FLS_DEST
    fuel:
      key: Mono
      From: H2
    oxidizer:
      key: Mono
      From: O2
    bathGas:
      key: Mono
      From: AR
    globalReaction:
      FromRxn: 2H2+O2==2H2O
    units:
      pressure: Pa
      temperature: K
      concentration: mol_fraction
  Flf:
    Flame: UnstretchedPremixed
    StartProfilesFile: PLACEHOLDER_FLF_INIT
    CopyTo: PLACEHOLDER_FLF_DEST
    fuel:
      key: Mono
      From: H2
    oxidizer:
      key: Mono
      From: O2
    bathGas:
      key: Mono
      From: AR
    globalReaction:
      FromRxn: 2H2+O2==2H2O
    units:
      pressure: Pa
      temperature: K
      concentration: mol_fraction

Stats:
  Design_of_PRS: A-facto
  Order_of_PRS: 2
  Sampling_of_PRS: 4
  PRS_type: Partial
  cut_off_percentage: 1
  MRE_criteria: 5.0
  Objective: powerMeanWMRE
  pm_p: 0.1
  pm_anneal: true
  pm_p_start: 1.0
  num_generations: 100
  Weights:
    Tig: 1.0

RMIP:
  database: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/project.db
  glossary: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/glossary.csv
  mechanisms:
    - name: mech_A
      path: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/mech_A.inp
      thermo: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/thermo_A.dat
      format: chemkin
    - name: mech_B
      path: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/mech_B.inp
      thermo: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/thermo_B.dat
      format: chemkin
    - name: mech_C
      path: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/mech_C.inp
      thermo: /data/MECHANISM_OPTIMIZATION_SUITE/src/rmip/tests/fixtures/gui_stress/thermo_C.dat
      format: chemkin
  fusion:
    name: gui_stress_fused
    description: Fused dummy H2/O2 mechanism (GUI stress test)
    uf_warn: 10.0
    out_dir: outputs/gui_stress/fusion
  reduction:
    method: DRG
    target_species: H2,O2,H2O
    eps_max: 0.5
    T: 1200.0
    P: 1.0
    phi: 1.0
    sa_json: null
    out_dir: outputs/gui_stress/reduction
  comparison:
    tol_A: 0.01
    tol_n: 0.001
    tol_Ea: 100.0
    out_dir: outputs/gui_stress/comparison

ForwardUQ:
  n_samples: 2048
  method: sobol
  output_dir: outputs/gui_stress/forward_uq
  plot_histogram: false
  plot_sobol: false
  ci_level: 0.95
